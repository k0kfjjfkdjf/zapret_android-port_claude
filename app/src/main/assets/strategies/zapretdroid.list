# Strategies built on what ZapretDroid adds to ByeDPI: tpws position markers, zapret2 fake
# payloads, fake SNI with TLS mods, tlsminor. Same format as byebyedpi.list; {fake:name} and
# {list:name} are resolved by the app.

# Every split method at tpws markers (SNI extension, middle of the second-level domain, host)
--split 1
--disorder 1
--oob 1
--disoob 1
--tlsrec 1
--split sniext
--disorder sniext
--oob sniext
--disoob sniext
--tlsrec sniext
--split sniext+1
--disorder sniext+1
--oob sniext+1
--disoob sniext+1
--tlsrec sniext+1
--split midsld
--disorder midsld
--oob midsld
--disoob midsld
--tlsrec midsld
--split host+1
--disorder host+1
--oob host+1
--disoob host+1
--tlsrec host+1
--split endhost-1
--disorder endhost-1
--oob endhost-1
--disoob endhost-1
--tlsrec endhost-1
--split sld+1
--disorder sld+1
--oob sld+1
--disoob sld+1
--tlsrec sld+1

# TLS record split at the SNI combined with a split or disorder inside the name
--tlsrec sniext --disorder midsld
--tlsrec sniext+1 --split midsld --disorder 1
--tlsrec sniext --disorder sniext+1
--tlsrec sniext+1 --split sniext+1 --disorder 1
--tlsrec sniext --disorder host+1
--tlsrec sniext+1 --split host+1 --disorder 1

# TLS minor version in the record header (ByeDPI --tlsminor)
--tlsrec 1+s --tlsminor 1
--disorder 1 --tlsminor 4

# zapret2 fake ClientHellos (Android-sized and Chrome-sized with the post-quantum key share), TTL sweep
--fake -1 --ttl 4 --fake-data {fake:tls_clienthello_www_google_com.bin}
--fake -1 --ttl 6 --fake-data {fake:tls_clienthello_www_google_com.bin}
--fake -1 --ttl 8 --fake-data {fake:tls_clienthello_www_google_com.bin}
--fake -1 --ttl 4 --fake-data {fake:tls_clienthello_vk_com_kyber.bin}
--fake -1 --ttl 6 --fake-data {fake:tls_clienthello_vk_com_kyber.bin}
--fake -1 --ttl 8 --fake-data {fake:tls_clienthello_vk_com_kyber.bin}
--fake -1 --ttl 4 --fake-data {fake:tls_clienthello_gosuslugi_ru.bin}
--fake -1 --ttl 6 --fake-data {fake:tls_clienthello_gosuslugi_ru.bin}
--fake -1 --ttl 8 --fake-data {fake:tls_clienthello_gosuslugi_ru.bin}
--fake -1 --ttl 4 --fake-data {fake:tls_clienthello_iana_org.bin}
--fake -1 --ttl 6 --fake-data {fake:tls_clienthello_iana_org.bin}
--fake -1 --ttl 8 --fake-data {fake:tls_clienthello_iana_org.bin}

# Fake with an allowed SNI before the real ClientHello: aimed at the IP-based freeze after
# 16-20 KB (the flow may be classified by the fake). TTL 2-10 for www.google.com, a few for others.
--fake -1 --ttl 2 --fake-tls-mod rand,orig --fake-sni www.google.com
--fake -1 --ttl 3 --fake-tls-mod rand,orig --fake-sni www.google.com
--fake -1 --ttl 4 --fake-tls-mod rand,orig --fake-sni www.google.com
--fake -1 --ttl 5 --fake-tls-mod rand,orig --fake-sni www.google.com
--fake -1 --ttl 6 --fake-tls-mod rand,orig --fake-sni www.google.com
--fake -1 --ttl 7 --fake-tls-mod rand,orig --fake-sni www.google.com
--fake -1 --ttl 8 --fake-tls-mod rand,orig --fake-sni www.google.com
--fake -1 --ttl 9 --fake-tls-mod rand,orig --fake-sni www.google.com
--fake -1 --ttl 10 --fake-tls-mod rand,orig --fake-sni www.google.com
--fake -1 --ttl 3 --fake-tls-mod rand,orig --fake-sni vk.com
--fake -1 --ttl 5 --fake-tls-mod rand,orig --fake-sni vk.com
--fake -1 --ttl 7 --fake-tls-mod rand,orig --fake-sni vk.com
--fake -1 --ttl 3 --fake-tls-mod rand,orig --fake-sni gosuslugi.ru
--fake -1 --ttl 5 --fake-tls-mod rand,orig --fake-sni gosuslugi.ru
--fake -1 --ttl 7 --fake-tls-mod rand,orig --fake-sni gosuslugi.ru

# Fake with an allowed SNI plus disorder at the SNI
--disorder sniext+1 --fake -1 --ttl 4 --fake-tls-mod rand,orig --fake-sni www.google.com
--disorder sniext+1 --fake -1 --ttl 6 --fake-tls-mod rand,orig --fake-sni www.google.com
--disorder sniext+1 --fake -1 --ttl 8 --fake-tls-mod rand,orig --fake-sni www.google.com

# From zapret-termux (tpws): multisplit at many markers with disorder and OOB, as its
# "discord", "discord_ultimate", "oob_split3", "tlsrec_1midsld_dis" (two-way Discord voice there)
# and --mss 88 (small TCP segments both ways).
--disoob 1 --disorder sniext+1 --disorder host+1 --disorder midsld-2 --disorder midsld --disorder midsld+2 --disorder endhost-1
--disoob 1 --disorder sniext --disorder sniext+1 --disorder sniext+2 --disorder host --disorder host+1 --disorder host+2 --disorder midsld --disorder midsld+1 --disorder midsld+2 --disorder endhost-2 --disorder endhost-1 --disorder endhost --tlsrec sniext+1 --tlsrec sniext+2 --tlsrec sniext+3
--disorder 1 --disorder midsld
--disoob 1 --disorder midsld
--disoob 1 --disorder 3 --disorder 5 --disorder 7 --disorder 9
--disoob 1 --disorder 2 --disorder 3 --disorder 4 --disorder 5 --disorder 6 --disorder 7 --disorder 8
--disorder 1 --disorder 2 --disorder 3 --disorder 4 --disorder 5 --disorder 6 --disorder 7 --disorder 8 --disorder 9 --disorder 10 --disorder 11 --disorder 12
--oob 3
--disorder 1 --disorder midsld --tlsrec sniext+1
--oob 1 --split midsld --tlsrec sniext+1
--oob 1 --split midsld --tlsrec sniext+1
--disorder 1 --mss 88
--tlsrec sniext+1 --mss 88
--disoob 1 --disorder sniext+1 --disorder host+1 --disorder midsld-2 --disorder midsld --disorder midsld+2 --disorder endhost-1 --mss 88

# From the ByeByeDPI Telegram group (t.me/byebyedpi_group/21941): per-service groups by domain.
# Reported working on T2 / Rostelecom (Mordovia) and Rostelecom / Yota (Ulyanovsk).
# Upstream ByeDPI matches host lists (-H) only on TCP, so UDP took the first group and
# --udp-fake in their Discord group never applied; ZapretDroid's engine names UDP flows (QUIC
# SNI, DNS answers, Discord IP discovery), so the groups now work as meant. The variants after
# them put a UDP group with protocol fakes (QUIC, Discord, STUN) first for every UDP flow.
-H:"googlevideo.com youtube.com youtu.be ytimg.com i.ytimg.com ggpht.com yt1.ggpht.com yt2.ggpht.com yt3.ggpht.com yt4.ggpht.com yt5.ggpht.com yt6.ggpht.com yt7.ggpht.com yt8.ggpht.com yt9.ggpht.com youtubei.googleapis.com googleapis.com googleusercontent.com lh3.googleusercontent.com music.youtube.com" -T4 -d1 -f-1 -S -s1 --udp-fake=10 -An -H:"discord.com discord.gg discordapp.com cdn.discordapp.com media.discordapp.net discord.media discordsays.com" -T4 -q1 -d1 -d3+s -s6+s -d9+s -s12+s -d15+s -s20+s -d25+s -s30+s -d35+s -r1+s -S -t6 --udp-fake=1 -An -H:"tr.rbxcdn.com images.rbxcdn.com static.rbxcdn.com css.rbxcdn.com thumbnails.roblox.com t0.rbxcdn.com t1.rbxcdn.com t2.rbxcdn.com t3.rbxcdn.com t4.rbxcdn.com t5.rbxcdn.com t6.rbxcdn.com t7.rbxcdn.com" -T4 -o1 -f-1 -S -At,r,s --udp-fake=1 -An -H:"instagram.com www.instagram.com cdninstagram.com fbcdn.net scontent.cdninstagram.com graph.instagram.com i.instagram.com b.i.instagram.com graph.facebook.com edge-mqtt.facebook.com rupload.facebook.com facebook.com fbsbx.com" -T8 -d1 -f-1 -S -s1 --udp-fake=10 -An -H:"soundcloud.com www.soundcloud.com api-v2.soundcloud.com sndcdn.com i1.sndcdn.com i2.sndcdn.com i3.sndcdn.com i4.sndcdn.com a1.sndcdn.com wis.sndcdn.com" -T6 -d1 -An -T4 -d1
-H:"googleapis.com" -s1 -r1+s -An -H:"ggpht.com googlevideo.com youtube.com youtu.be ytimg.com" -o1 -r-5+se -An -H:"discord.com discord.gg discord.media discordapp.net dis.gd" -s1+s -d3+s -f-1 -t4 -Qorig -a2 -An -d1 -d3+s -s6+s -d9+s -s12+s -d15+s -s20+s -r1+s -a2 -As -e1 -f2
--proto u --ttl 4 --udp-fake 6 --udp-desync 4 --udp-proto-fake quic:{fake:quic_initial_www_google_com.bin} --udp-proto-fake discord:{fake:discord-ip-discovery-with-port.bin} --udp-proto-fake stun:{fake:stun.bin} -An -H:"googlevideo.com youtube.com youtu.be ytimg.com i.ytimg.com ggpht.com yt1.ggpht.com yt2.ggpht.com yt3.ggpht.com yt4.ggpht.com yt5.ggpht.com yt6.ggpht.com yt7.ggpht.com yt8.ggpht.com yt9.ggpht.com youtubei.googleapis.com googleapis.com googleusercontent.com lh3.googleusercontent.com music.youtube.com" -T4 -d1 -f-1 -S -s1 --udp-fake=10 -An -H:"discord.com discord.gg discordapp.com cdn.discordapp.com media.discordapp.net discord.media discordsays.com" -T4 -q1 -d1 -d3+s -s6+s -d9+s -s12+s -d15+s -s20+s -d25+s -s30+s -d35+s -r1+s -S -t6 --udp-fake=1 -An -H:"tr.rbxcdn.com images.rbxcdn.com static.rbxcdn.com css.rbxcdn.com thumbnails.roblox.com t0.rbxcdn.com t1.rbxcdn.com t2.rbxcdn.com t3.rbxcdn.com t4.rbxcdn.com t5.rbxcdn.com t6.rbxcdn.com t7.rbxcdn.com" -T4 -o1 -f-1 -S -At,r,s --udp-fake=1 -An -H:"instagram.com www.instagram.com cdninstagram.com fbcdn.net scontent.cdninstagram.com graph.instagram.com i.instagram.com b.i.instagram.com graph.facebook.com edge-mqtt.facebook.com rupload.facebook.com facebook.com fbsbx.com" -T8 -d1 -f-1 -S -s1 --udp-fake=10 -An -H:"soundcloud.com www.soundcloud.com api-v2.soundcloud.com sndcdn.com i1.sndcdn.com i2.sndcdn.com i3.sndcdn.com i4.sndcdn.com a1.sndcdn.com wis.sndcdn.com" -T6 -d1 -An -T4 -d1
--proto u --ttl 4 --udp-fake 6 --udp-desync 4 --udp-proto-fake quic:{fake:quic_initial_www_google_com.bin} --udp-proto-fake discord:{fake:discord-ip-discovery-with-port.bin} --udp-proto-fake stun:{fake:stun.bin} -An -H:"googleapis.com" -s1 -r1+s -An -H:"ggpht.com googlevideo.com youtube.com youtu.be ytimg.com" -o1 -r-5+se -An -H:"discord.com discord.gg discord.media discordapp.net dis.gd" -s1+s -d3+s -f-1 -t4 -Qorig -a2 -An -d1 -d3+s -s6+s -d9+s -s12+s -d15+s -s20+s -r1+s -a2 -As -e1 -f2
