    <string name="strategy_fake">Фейковый пакет</string>
    <string name="strategy_fake_desc">Сначала отправляет обманку с низким TTL; TTL может понадобиться подобрать под провайдера</string>
    <string name="strategy_quic">TCP + QUIC/UDP</string>
