<resources>
    <style name="BbTheme.ByeDPI" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#5976DF</item>
        <item name="colorPrimaryVariant">#3C52A3</item>
        <item name="colorOnPrimary">#FFFFFF</item>

        <item name="colorSecondary">#5976DF</item>
        <item name="colorSecondaryVariant">#3C52A3</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <item name="android:statusBarColor">#3C52A3</item>

        <item name="colorSurface">#F5F5F5</item>
        <item name="colorOnSurface">#212121</item>

        <item name="materialCardViewStyle">@style/BbSmallShadowCard</item>
    </style>

    <style name="BbAppToolbar" parent="Widget.MaterialComponents.Toolbar.Primary" />

    <style name="BbSmallShadowCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">1dp</item>
    </style>

    <style name="BbCircleButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">60dp</item>
        <item name="android:textSize">0sp</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="iconTint">?attr/colorOnPrimary</item>
    </style>

    <style name="BbCustomAlertDialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <!-- -->
    </style>

    <style name="BbPillCard">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
