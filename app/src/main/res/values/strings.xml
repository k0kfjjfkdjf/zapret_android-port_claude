    <string name="strategy_byebyedpi_desc">The default command line of ByeByeDPI</string>
    <string name="strategy_custom">Custom</string>
    <string name="strategy_custom_desc">Your own ByeDPI command line</string>
    <string name="strategy_args">ByeDPI arguments</string>
    <string name="strategy_args_hint">Editing switches to a custom strategy. --ip and --port are set by the app. Positions accept zapret markers (host, endhost, sld, midsld, endsld, sniext, method, e.g. midsld+1); -M accepts tpws modifications (hostcase, hostdot, hosttab, hostnospace, hostpad=N, methodspace, methodeol, unixeol).</string>

