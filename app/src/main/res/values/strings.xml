    <string name="section_strategy">Bypass strategy</string>
    <string name="strategy_auto">Adaptive</string>
    <string name="strategy_auto_desc">Disorder; if a connection looks blocked, switches to splitting TLS records</string>
    <string name="strategy_disorder">Disorder</string>
    <string name="strategy_disorder_desc">Sends the first byte out of order</string>
    <string name="strategy_split_sni">Split at SNI</string>
    <string name="strategy_split_sni_desc">Splits the request inside the domain name</string>
    <string name="strategy_oob_sni">OOB at SNI</string>
    <string name="strategy_oob_sni_desc">Inserts an out-of-band byte into the domain name</string>
    <string name="strategy_tlsrec">TLS records</string>
    <string name="strategy_tlsrec_desc">Splits the ClientHello into two TLS records, falls back to disorder</string>
    <string name="strategy_fake">Fake packet</string>
    <string name="strategy_fake_desc">Sends a decoy with low TTL first; the TTL may need tuning for your ISP</string>
    <string name="strategy_quic">TCP + QUIC/UDP</string>
    <string name="strategy_quic_desc">Disorder and TLS records for TCP; a fake QUIC Initial from zapret2 before the first 4 datagrams of UDP 443 (YouTube)</string>
