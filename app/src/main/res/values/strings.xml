    <string name="title_test">Find a strategy</string>
    <string name="test_open">Find a strategy automatically</string>
    <string name="test_open_desc">Try strategies one by one against chosen sites, like zapret\'s blockcheck</string>
    <string name="test_intro">Each strategy is started as a local proxy and the sites are opened over HTTPS through it: connection, TLS handshake with certificate check, HTTP response and up to 128 KB of the body. Works with the VPN on or off. QUIC and calls (UDP) are checked in the UDP mode.</string>
