<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="byedpi_cmd_settings">

    <EditTextPreference
        android:key="byedpi_cmd_args"
        android:title="@string/bb_command_line_arguments"
        android:dialogTitle="@string/bb_command_line_arguments"
        android:inputType="textMultiLine"
        app:iconSpaceReserved="false"
        app:useSimpleSummaryProvider="true" />

    <Preference
        android:key="cmd_editor_buttons"
        android:layout="@layout/bb_cmd_editor_buttons"
        android:selectable="false" />

    <Preference
        android:key="cmd_history_header"
        android:title="@string/bb_cmd_history_title"
        android:summary="@string/bb_cmd_history_title_summary"
        android:layout="@layout/bb_history_category" />

</PreferenceScreen>
