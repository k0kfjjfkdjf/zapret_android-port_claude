index 0000000..8651671
--- /dev/null
+++ b/tpws/udp.c
@@ -0,0 +1,821 @@
+#define _GNU_SOURCE
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <errno.h>
+#include <unistd.h>
+#include <fcntl.h>
+#include <arpa/inet.h>
+#include <netinet/in.h>
+#include <sys/epoll.h>
+#include <time.h>
+
+#include "udp.h"
+#include "params.h"
+#include "socks.h"
+#include "pools.h"
+#include "resolver.h"
+
+#define UDP_BUF_SIZE	65536
+#define S5_UDP_HDR_MAX	(4+1+255+2)
+
+static uint8_t udpbuf[UDP_BUF_SIZE + S5_UDP_HDR_MAX];
+
+uint64_t zt_now_ms(void)
+{
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (uint64_t)ts.tv_sec*1000 + ts.tv_nsec/1000000;
+}
+const char *zt_ts(void)
+{
+	static char buf[16];
+	struct timespec ts;
+	struct tm tm;
+	clock_gettime(CLOCK_REALTIME, &ts);
+	localtime_r(&ts.tv_sec, &tm);
+	snprintf(buf, sizeof(buf), "%02d:%02d:%02d.%03ld", tm.tm_hour, tm.tm_min, tm.tm_sec, ts.tv_nsec/1000000);
+	return buf;
+}
+
+// global domain -> ip cache for socks5 udp requests with ATYP=domain
+// (hev-socks5-tunnel / SocksTun with "Remote DNS" sends domain names instead of ips)
+#define DNSCACHE_SIZE		256
+#define DNSCACHE_TTL		300
+#define DNSCACHE_NEG_TTL	15
+static struct {
+	char dom[256];
+	sockaddr_in46 addr;	// sa_family==0 => negative entry
+	time_t expire;
+} dnscache[DNSCACHE_SIZE];
+
+// returns 1 = found, -1 = negative entry, 0 = not in cache
+static int dnscache_get(const char *dom, sockaddr_in46 *addr, time_t now)
+{
+	int i;
+	for (i=0;i<DNSCACHE_SIZE;i++)
+		if (dnscache[i].expire > now && !strcasecmp(dnscache[i].dom,dom))
+		{
+			if (!dnscache[i].addr.sa_family) return -1;
+			*addr = dnscache[i].addr;
+			return 1;
+		}
+	return 0;
+}
+static void dnscache_put(const char *dom, const sockaddr_in46 *addr, time_t now)
+{
+	int i, victim=0;
+	for (i=0;i<DNSCACHE_SIZE;i++)
+	{
+		if (!strcasecmp(dnscache[i].dom,dom)) { victim=i; break; }
+		if (dnscache[i].expire < dnscache[victim].expire) victim=i;
+	}
+	snprintf(dnscache[victim].dom,sizeof(dnscache[victim].dom),"%s",dom);
+	if (addr)
+	{
+		dnscache[victim].addr = *addr;
+		dnscache[victim].expire = now + DNSCACHE_TTL;
+	}
+	else
+	{
+		memset(&dnscache[victim].addr,0,sizeof(dnscache[victim].addr));
+		dnscache[victim].expire = now + DNSCACHE_NEG_TTL;
+	}
+}
+
+static socklen_t sa46len(const struct sockaddr *sa)
+{
+	return sa->sa_family==AF_INET6 ? sizeof(struct sockaddr_in6) : sizeof(struct sockaddr_in);
+}
+
+static bool sa46_eq(const sockaddr_in46 *a, const sockaddr_in46 *b)
+{
+	if (a->sa_family!=b->sa_family) return false;
+	if (a->sa_family==AF_INET)
+		return a->sa4.sin_port==b->sa4.sin_port && a->sa4.sin_addr.s_addr==b->sa4.sin_addr.s_addr;
+	return a->sa6.sin6_port==b->sa6.sin6_port && !memcmp(&a->sa6.sin6_addr,&b->sa6.sin6_addr,sizeof(struct in6_addr));
+}
+static bool sa46_ip_eq(const sockaddr_in46 *a, const sockaddr_in46 *b)
+{
+	if (a->sa_family!=b->sa_family) return false;
+	if (a->sa_family==AF_INET)
+		return a->sa4.sin_addr.s_addr==b->sa4.sin_addr.s_addr;
+	return !memcmp(&a->sa6.sin6_addr,&b->sa6.sin6_addr,sizeof(struct in6_addr));
+}
+static uint16_t sa46_port(const sockaddr_in46 *a)
+{
+	return a->sa_family==AF_INET ? a->sa4.sin_port : a->sa6.sin6_port;
+}
+static void sa46_set_port(sockaddr_in46 *a, uint16_t port)
+{
+	if (a->sa_family==AF_INET) a->sa4.sin_port=port; else a->sa6.sin6_port=port;
+}
+// ::ffff:a.b.c.d -> a.b.c.d
+static void sa46_unmap(sockaddr_in46 *a)
+{
+	if (a->sa_family==AF_INET6 && IN6_IS_ADDR_V4MAPPED(&a->sa6.sin6_addr))
+	{
+		struct sockaddr_in sa4;
+		memset(&sa4,0,sizeof(sa4));
+		sa4.sin_family = AF_INET;
+		sa4.sin_port = a->sa6.sin6_port;
+		memcpy(&sa4.sin_addr, a->sa6.sin6_addr.s6_addr+12, 4);
+		a->sa4 = sa4;
+	}
+}
+
+static bool set_nonblock(int fd)
+{
+	int fl = fcntl(fd, F_GETFL);
+	return fl!=-1 && fcntl(fd, F_SETFL, fl|O_NONBLOCK)!=-1;
+}
+
+static bool udp_epoll_add(struct udp_assoc *ua, struct udp_sock *us)
+{
+	struct epoll_event ev;
+	memset(&ev,0,sizeof(ev));
+	ev.events = EPOLLIN;
+	ev.data.ptr = (void*)(((uintptr_t)us) | UDP_EV_TAG);
+	if (epoll_ctl(ua->efd, EPOLL_CTL_ADD, us->fd, &ev)==-1)
+	{
+		DLOG_PERROR("udp epoll_ctl (add)");
+		return false;
+	}
+	return true;
+}
+
+static void udp_sock_close(struct udp_assoc *ua, int kind)
+{
+	if (ua->s[kind].fd>0)
+	{
+		epoll_ctl(ua->efd, EPOLL_CTL_DEL, ua->s[kind].fd, NULL);
+		close(ua->s[kind].fd);
+	}
+	ua->s[kind].fd = 0;
+}
+
+static int udp_out_sock(struct udp_assoc *ua, sa_family_t family)
+{
+	int kind = family==AF_INET6 ? UDP_SOCK_OUT6 : UDP_SOCK_OUT4;
+	struct udp_sock *us = ua->s + kind;
+	int fd;
+
+	if (us->fd>0) return us->fd;
+
+	if ((fd = socket(family, SOCK_DGRAM, 0))==-1)
+	{
+		DLOG_PERROR("udp socket (out)");
+		return -1;
+	}
+	if (!set_nonblock(fd))
+	{
+		DLOG_PERROR("udp set O_NONBLOCK (out)");
+		close(fd);
+		return -1;
+	}
+	if (family==AF_INET6)
+	{
+		int v6only=1;
+		setsockopt(fd, IPPROTO_IPV6, IPV6_V6ONLY, &v6only, sizeof(v6only));
+		if (params.connect_bind6.sin6_family==AF_INET6)
+		{
+			struct sockaddr_in6 b = params.connect_bind6;
+			b.sin6_port = 0;
+			if (bind(fd,(struct sockaddr*)&b,sizeof(b))==-1)
+				DLOG_PERROR("udp bind (connect-bind-addr v6)");
+		}
+	}
+	else if (params.connect_bind4.sin_family==AF_INET)
+	{
+		struct sockaddr_in b = params.connect_bind4;
+		b.sin_port = 0;
+		if (bind(fd,(struct sockaddr*)&b,sizeof(b))==-1)
+			DLOG_PERROR("udp bind (connect-bind-addr v4)");
+	}
+	us->fd = fd;
+	if (!udp_epoll_add(ua, us))
+	{
+		close(fd);
+		us->fd = 0;
+		return -1;
+	}
+	return fd;
+}
+
+struct udp_assoc *udp_assoc_create(void *ctl, int efd, int ctl_fd, uint16_t req_port, struct sockaddr_storage *bnd)
+{
+	struct udp_assoc *ua;
+	sockaddr_in46 local, peer;
+	struct sockaddr_storage ss;
+	socklen_t sl;
+	int fd, k;
+
+	sl = sizeof(ss);
+	if (getsockname(ctl_fd,(struct sockaddr*)&ss,&sl)==-1)
+	{
+		DLOG_PERROR("udp getsockname (ctl)");
+		return NULL;
+	}
+	sa46copy(&local,(struct sockaddr*)&ss);
+	sl = sizeof(ss);
+	if (getpeername(ctl_fd,(struct sockaddr*)&ss,&sl)==-1)
+	{
+		DLOG_PERROR("udp getpeername (ctl)");
+		return NULL;
+	}
+	sa46copy(&peer,(struct sockaddr*)&ss);
+	sa46_unmap(&local);
+	sa46_unmap(&peer);
+
+	if (!(ua = calloc(1,sizeof(*ua))))
+	{
+		DLOG_ERR("udp_assoc_create: out of memory\n");
+		return NULL;
+	}
+	ua->ctl = ctl;
+	ua->efd = efd;
+	for (k=0;k<UDP_SOCK_COUNT;k++)
+	{
+		ua->s[k].ua = ua;
+		ua->s[k].kind = k;
+	}
+	ua->client = peer;
+	sa46_set_port(&ua->client, req_port);
+	ua->client_port_known = !!req_port;
+	ua->last = time(NULL);
+
+	// relay socket listens on the same address client used to reach tcp socks port
+	if ((fd = socket(local.sa_family, SOCK_DGRAM, 0))==-1)
+	{
+		DLOG_PERROR("udp socket (relay)");
+		free(ua);
+		return NULL;
+	}
+	ua->s[UDP_SOCK_RELAY].fd = fd;
+	sa46_set_port(&local, 0);
+	if (bind(fd,(struct sockaddr*)&local,sa46len((struct sockaddr*)&local))==-1 || !set_nonblock(fd))
+	{
+		DLOG_PERROR("udp bind (relay)");
+		udp_assoc_destroy(ua);
+		return NULL;
+	}
+	sl = sizeof(ss);
+	if (getsockname(fd,(struct sockaddr*)&ss,&sl)==-1)
+	{
+		DLOG_PERROR("udp getsockname (relay)");
+		udp_assoc_destroy(ua);
+		return NULL;
+	}
+	if (!udp_epoll_add(ua, ua->s+UDP_SOCK_RELAY))
+	{
+		udp_assoc_destroy(ua);
+		return NULL;
+	}
+	memcpy(bnd,&ss,sizeof(ss));
+
+	if (params.debug)
+	{
+		char s1[48],s2[48];
+		ntop46_port((struct sockaddr*)&ss,s1,sizeof(s1));
+		ntop46_port((struct sockaddr*)&ua->client,s2,sizeof(s2));
+		VPRINT("udp associate : relay %s for client %s\n",s1,s2);
+	}
+	return ua;
+}
+
+static const char *udp_proto_name(uint8_t p)
+{
+	switch(p)
+	{
+		case UDP_PROTO_QUIC: return "quic";
+		case UDP_PROTO_DISCORD: return "discord";
+		case UDP_PROTO_STUN: return "stun";
+		default: return "unknown";
+	}
+}
+static void udp_flow_log_end(const struct udp_flow *f, const char *why)
+{
+	if (params.debug>=1)
+	{
+		char s[48];
+		ntop46_port((const struct sockaddr*)&f->dst,s,sizeof(s));
+		char fr[32];
+		if (f->t_first_in_ms) snprintf(fr,sizeof(fr),"%llums",(unsigned long long)(f->t_first_in_ms - f->t_start_ms));
+		else snprintf(fr,sizeof(fr),"none");
+		VPRINT("udp flow end (%s) : -> %s proto=%s out=%u pkts/%llu bytes in=%u pkts/%llu bytes first_reply=%s fakes=%u%s%s\n",
+			why, s, udp_proto_name(f->proto), f->out_count, (unsigned long long)f->out_bytes, f->in_count, (unsigned long long)f->in_bytes,
+			fr, f->fakes,
+			f->disc_sent>1 ? " DISCOVERY_RETRIES" : "",
+			f->out_count && !f->in_count ? "  <-- NO REPLY" : "");
+	}
+}
+void udp_assoc_destroy(struct udp_assoc *ua)
+{
+	struct udp_flow *f,*fn;
+	int k;
+
+	if (!ua) return;
+	VPRINT("udp associate closed : relay_fd=%d out=%llu in=%llu fakes=%llu flows=%u\n",
+		ua->s[UDP_SOCK_RELAY].fd, (unsigned long long)ua->pkt_out, (unsigned long long)ua->pkt_in, (unsigned long long)ua->fakes, ua->flow_count);
+	for (k=0;k<UDP_SOCK_COUNT;k++) udp_sock_close(ua,k);
+	{
+		struct udp_pending *p,*pn;
+		for (p=ua->pending;p;p=pn)
+		{
+			pn=p->next;
+			if (p->ri) p->ri->ptr = NULL; // detach. resolver result will be discarded
+			for (k=0;k<p->count;k++) free(p->pkt[k].data);
+			free(p);
+		}
+	}
+	for (f=ua->flows;f;f=fn)
+	{
+		fn=f->next;
+		udp_flow_log_end(f,"close");
+		free(f);
+	}
+	free(ua);
+}
+
+bool udp_assoc_expired(const struct udp_assoc *ua, time_t now)
+{
+	return params.udp_timeout && (now - ua->last) >= params.udp_timeout;
+}
+
+static void udp_flows_gc(struct udp_assoc *ua, time_t now)
+{
+	struct udp_flow **pp = &ua->flows, *f;
+	while ((f=*pp))
+	{
+		if ((now - f->last) >= (params.udp_timeout ? params.udp_timeout : UDP_DEFAULT_TIMEOUT))
+		{
+			*pp = f->next;
+			udp_flow_log_end(f,"idle");
+			free(f);
+			ua->flow_count--;
+		}
+		else
+			pp = &f->next;
+	}
+}
+
+static struct udp_flow *udp_flow_get(struct udp_assoc *ua, const sockaddr_in46 *dst, time_t now)
+{
+	struct udp_flow *f;
+
+	for (f=ua->flows;f;f=f->next)
+		if (sa46_eq(&f->dst,dst)) return f;
+
+	if (ua->flow_count>=UDP_MAX_FLOWS)
+	{
+		udp_flows_gc(ua,now);
+		if (ua->flow_count>=UDP_MAX_FLOWS) return NULL;
+	}
+	if (!(f = calloc(1,sizeof(*f)))) return NULL;
+	f->dst = *dst;
+	f->next = ua->flows;
+	ua->flows = f;
+	ua->flow_count++;
+	return f;
+}
+
+// QUIC long header Initial packet
+static bool is_quic_initial(const uint8_t *data, size_t len)
+{
+	if (len<7 || (data[0] & 0xC0)!=0xC0) return false;
+	uint32_t ver = ((uint32_t)data[1]<<24)|((uint32_t)data[2]<<16)|((uint32_t)data[3]<<8)|data[4];
+	if (!ver) return false; // version negotiation
+	// QUICv2 (0x6b3343cf) uses type 01 for Initial, v1 and drafts use 00
+	uint8_t type = (data[0]>>4) & 3;
+	return ver==0x6b3343cf ? type==1 : type==0;
+}
+
+// discord voice ip discovery request : type=1 len=70 total 74 bytes
+static bool is_discord_ip_discovery(const uint8_t *d, size_t len)
+{
+	return len==74 && d[0]==0 && d[1]==1 && d[2]==0 && d[3]==70;
+}
+// STUN : 2 top bits zero, magic cookie 0x2112A442
+static bool is_stun(const uint8_t *d, size_t len)
+{
+	return len>=20 && !(d[0]&0xC0) && d[4]==0x21 && d[5]==0x12 && d[6]==0xA4 && d[7]==0x42 && (((size_t)d[2]<<8|d[3])+20)==len;
+}
+static uint8_t udp_detect_proto(const uint8_t *d, size_t len)
+{
+	if (is_quic_initial(d,len)) return UDP_PROTO_QUIC;
+	if (is_discord_ip_discovery(d,len)) return UDP_PROTO_DISCORD;
+	if (is_stun(d,len)) return UDP_PROTO_STUN;
+	return UDP_PROTO_UNKNOWN;
+}
+
+static bool udp_set_ttl(int fd, sa_family_t family, int ttl)
+{
+	if (family==AF_INET6)
+		return setsockopt(fd, IPPROTO_IPV6, IPV6_UNICAST_HOPS, &ttl, sizeof(ttl))!=-1;
+	else
+		return setsockopt(fd, IPPROTO_IP, IP_TTL, &ttl, sizeof(ttl))!=-1;
+}
+
+static int udp_send_fakes(struct udp_assoc *ua, int fd, const sockaddr_in46 *dst, uint8_t proto)
+{
+	const uint8_t *fake = params.udp_fake;
+	size_t fake_size = params.udp_fake_size;
+	int ttl, k;
+
+	ttl = dst->sa_family==AF_INET6 ? params.udp_fake_ttl6 : params.udp_fake_ttl;
+	if (!ttl) return 0;
+
+	switch(proto)
+	{
+		case UDP_PROTO_QUIC:
+			if (params.udp_fake_quic_size) { fake=params.udp_fake_quic; fake_size=params.udp_fake_quic_size; }
+			break;
+		case UDP_PROTO_DISCORD:
+			if (params.udp_fake_discord_size) { fake=params.udp_fake_discord; fake_size=params.udp_fake_discord_size; }
+			break;
+		case UDP_PROTO_STUN:
+			if (params.udp_fake_stun_size) { fake=params.udp_fake_stun; fake_size=params.udp_fake_stun_size; }
+			break;
+	}
+	if (!fake_size) return 0;
+
+	if (!udp_set_ttl(fd, dst->sa_family, ttl))
+	{
+		DLOG_PERROR("udp setsockopt (fake ttl)");
+		return 0;
+	}
+	for (k=0;k<params.udp_fake_repeats;k++)
+	{
+		if (sendto(fd, fake, fake_size, 0, (struct sockaddr*)dst, sa46len((struct sockaddr*)dst))<0)
+		{
+			DLOG_PERROR("udp sendto (fake)");
+			break;
+		}
+		ua->fakes++;
+	}
+	// -1 = system default
+	udp_set_ttl(fd, dst->sa_family, params.ttl_default ? params.ttl_default : -1);
+
+	if (params.debug>=2)
+	{
+		char s[48];
+		ntop46_port((struct sockaddr*)dst,s,sizeof(s));
+		DBGPRINT("udp desync : %d fake(s) size=%zu ttl=%d proto=%s -> %s\n", k, fake_size, ttl, udp_proto_name(proto), s);
+	}
+	return k;
+}
+
+// parse socks5 udp request header. returns header length or 0 if invalid
+// if address is a domain name (not ip literal) - dst->sa_family=0, host filled, *dport set
+static size_t s5_udp_parse(const uint8_t *p, size_t len, sockaddr_in46 *dst, char *host, uint16_t *dport)
+{
+	memset(dst,0,sizeof(*dst));
+	*host = 0;
+	if (len<4) return 0;
+	if (p[0] || p[1]) return 0; // RSV
+	if (p[2])
+	{
+		DBGPRINT("udp socks5 fragmentation not supported\n");
+		return 0;
+	}
+	switch(p[3])
+	{
+		case S5_ATYP_IP4:
+			if (len<10) return 0;
+			dst->sa4.sin_family = AF_INET;
+			memcpy(&dst->sa4.sin_addr,p+4,4);
+			memcpy(&dst->sa4.sin_port,p+8,2);
+			return 10;
+		case S5_ATYP_IP6:
+			if (len<22) return 0;
+			dst->sa6.sin6_family = AF_INET6;
+			memcpy(&dst->sa6.sin6_addr,p+4,16);
+			memcpy(&dst->sa6.sin6_port,p+20,2);
+			return 22;
+		case S5_ATYP_DOM:
+			{
+				uint8_t l;
+				uint16_t port;
+				if (len<5) return 0;
+				l = p[4];
+				if (len<(size_t)(5+l+2)) return 0;
+				memcpy(host,p+5,l); host[l]=0;
+				memcpy(&port,p+5+l,2);
+				if (inet_pton(AF_INET,host,&dst->sa4.sin_addr)==1)
+				{
+					dst->sa4.sin_family = AF_INET;
+					dst->sa4.sin_port = port;
+				}
+				else if (inet_pton(AF_INET6,host,&dst->sa6.sin6_addr)==1)
+				{
+					dst->sa6.sin6_family = AF_INET6;
+					dst->sa6.sin6_port = port;
+				}
+				else
+				{
+					if (!l) return 0;
+					*dport = port;	// resolved asynchronously by caller
+					return 5+l+2;
+				}
+				*host = 0; // ip literal, no resolve needed
+				return 5+l+2;
+			}
+	}
+	return 0;
+}
+
+static size_t s5_udp_hdr(uint8_t *p, const sockaddr_in46 *src)
+{
+	p[0]=p[1]=p[2]=0;
+	if (src->sa_family==AF_INET6)
+	{
+		p[3]=S5_ATYP_IP6;
+		memcpy(p+4,&src->sa6.sin6_addr,16);
+		memcpy(p+20,&src->sa6.sin6_port,2);
+		return 22;
+	}
+	p[3]=S5_ATYP_IP4;
+	memcpy(p+4,&src->sa4.sin_addr,4);
+	memcpy(p+8,&src->sa4.sin_port,2);
+	return 10;
+}
+
+// send payload to resolved destination with optional desync
+static void udp_send_out(struct udp_assoc *ua, sockaddr_in46 *dst_in, const uint8_t *data, size_t len)
+{
+	sockaddr_in46 dst = *dst_in;
+	int fd;
+	time_t now;
+	struct udp_flow *f;
+
+	sa46_unmap(&dst);
+	if (!sa46_port(&dst)) return;
+	if ((fd = udp_out_sock(ua,dst.sa_family))<0) return;
+
+	now = time(NULL);
+
+	if ((f = udp_flow_get(ua,&dst,now)))
+	{
+		uint8_t proto = udp_detect_proto(data,len);
+		bool desync = params.udp_desync && port_filters_in_range(&params.udp_pf, ntohs(sa46_port(&dst)));
+		int nf = 0;
+		bool first = !f->out_count;
+		if (first)
+		{
+			f->proto = proto;
+			f->t_start_ms = zt_now_ms();
+		}
+		f->last = now;
+		if (desync && f->out_count < params.udp_desync_count)
+			// packet's own protocol first, else flow's protocol (rtp after discord ip discovery)
+			nf = udp_send_fakes(ua,fd,&dst,proto ? proto : f->proto);
+		f->fakes += nf;
+		if (proto==UDP_PROTO_DISCORD) f->disc_sent++;
+		if (params.debug>=1)
+		{
+			char s[48];
+			ntop46_port((struct sockaddr*)&dst,s,sizeof(s));
+			if (first)
+				// fakes (if any) are already sent at this point - before the real first datagram
+				VPRINT("%s udp flow start : -> %s proto=%s len=%zu desync=%s fakes_before_first=%d\n",
+					zt_ts(), s, udp_proto_name(proto), len, desync ? "yes" : "no", nf);
+			else if (proto==UDP_PROTO_DISCORD && !f->in_count)
+				VPRINT("%s udp discord ip discovery RETRY #%u -> %s after %llums without reply\n",
+					zt_ts(), f->disc_sent-1, s, (unsigned long long)(zt_now_ms()-f->t_start_ms));
+		}
+		f->out_count++;
+		f->out_bytes += len;
+	}
+
+	if (sendto(fd, data, len, 0, (struct sockaddr*)&dst, sa46len((struct sockaddr*)&dst))<0)
+		DBGPRINT("udp sendto (out) error %d\n",errno);
+	else
+		ua->pkt_out++;
+}
+
+// buffer datagram until domain is resolved
+static void udp_pending_add(struct udp_assoc *ua, const char *host, uint16_t port, const uint8_t *data, size_t len)
+{
+	struct udp_pending *p;
+	uint8_t *copy;
+
+	if (params.no_resolve)
+	{
+		VPRINT("udp socks5 : domain %s dropped because of --no-resolve\n",host);
+		return;
+	}
+	for (p=ua->pending;p;p=p->next)
+		if (!strcasecmp(p->dom,host)) break;
+	if (!p)
+	{
+		if (ua->pending_count>=UDP_PENDING_DOMS)
+		{
+			DBGPRINT("udp too many pending resolves. dropping datagram to %s\n",host);
+			return;
+		}
+		if (!(p = calloc(1,sizeof(*p)))) return;
+		p->ua = ua;
+		snprintf(p->dom,sizeof(p->dom),"%s",host);
+		if (!(p->ri = resolver_queue(host, ntohs(port), (void*)(((uintptr_t)p) | UDP_EV_TAG))))
+		{
+			DLOG_ERR("udp could not queue resolve for %s\n",host);
+			free(p);
+			return;
+		}
+		p->next = ua->pending;
+		ua->pending = p;
+		ua->pending_count++;
+		DBGPRINT("udp resolving %s\n",host);
+	}
+	if (p->count>=UDP_PENDING_PKTS)
+	{
+		DBGPRINT("udp pending queue full for %s. dropping datagram\n",host);
+		return;
+	}
+	if (!(copy = malloc(len ? len : 1))) return;
+	memcpy(copy,data,len);
+	p->pkt[p->count].data = copy;
+	p->pkt[p->count].len = len;
+	p->pkt[p->count].port = port;
+	p->count++;
+}
+
+void udp_resolve_complete(struct resolve_item *ri)
+{
+	struct udp_pending *p = (struct udp_pending*)(((uintptr_t)ri->ptr) & ~UDP_EV_TAG);
+	struct udp_pending **pp;
+	struct udp_assoc *ua;
+	sockaddr_in46 addr;
+	time_t now = time(NULL);
+	int k;
+
+	if (!p)
+	{
+		DBGPRINT("udp orphaned resolve for %s\n",ri->dom);
+		return;
+	}
+	ua = p->ua;
+	p->ri = NULL;
+	if (ri->ga_res)
+	{
+		VPRINT("udp could not resolve %s : %s\n",ri->dom,gai_strerror(ri->ga_res));
+		dnscache_put(p->dom,NULL,now);
+	}
+	else
+	{
+		addr = ri->ss;
+		sa46_unmap(&addr);
+		sa46_set_port(&addr,0);
+		dnscache_put(p->dom,&addr,now);
+		if (params.debug)
+		{
+			char s[48];
+			ntop46((struct sockaddr*)&addr,s,sizeof(s));
+			VPRINT("udp resolved %s -> %s. sending %d buffered datagram(s)\n",p->dom,s,p->count);
+		}
+		for (k=0;k<p->count;k++)
+		{
+			sa46_set_port(&addr,p->pkt[k].port);
+			udp_send_out(ua,&addr,p->pkt[k].data,p->pkt[k].len);
+		}
+	}
+	for (k=0;k<p->count;k++) free(p->pkt[k].data);
+	for (pp=&ua->pending; *pp; pp=&(*pp)->next)
+		if (*pp==p)
+		{
+			*pp = p->next;
+			ua->pending_count--;
+			break;
+		}
+	free(p);
+}
+
+// client -> remote
+static void udp_from_client(struct udp_assoc *ua, const uint8_t *data, size_t len, sockaddr_in46 *from)
+{
+	sockaddr_in46 dst;
+	size_t hl;
+	char host[256];
+	uint16_t dport=0;
+
+	sa46_unmap(from);
+	if (!sa46_ip_eq(from,&ua->client))
+	{
+		DBGPRINT("udp datagram from foreign ip dropped\n");
+		return;
+	}
+	if (!ua->client_port_known)
+	{
+		sa46_set_port(&ua->client, sa46_port(from));
+		ua->client_port_known = true;
+	}
+	else if (sa46_port(from)!=sa46_port(&ua->client))
+	{
+		DBGPRINT("udp datagram from foreign port dropped\n");
+		return;
+	}
+	if (!(hl = s5_udp_parse(data,len,&dst,host,&dport)))
+	{
+		DBGPRINT("udp invalid socks5 udp header\n");
+		return;
+	}
+	data+=hl; len-=hl;
+
+	if (*host)
+	{
+		switch(dnscache_get(host,&dst,time(NULL)))
+		{
+			case 1:
+				sa46_set_port(&dst,dport);
+				break;
+			case -1:
+				DBGPRINT("udp %s is in negative dns cache. dropped\n",host);
+				return;
+			default:
+				udp_pending_add(ua,host,dport,data,len);
+				return;
+		}
+	}
+	udp_send_out(ua,&dst,data,len);
+}
+
+// remote -> client
+static void udp_from_remote(struct udp_assoc *ua, int fd)
+{
+	struct sockaddr_storage ss;
+	socklen_t sl;
+	ssize_t rd;
+	sockaddr_in46 src;
+	size_t hl;
+
+	for(;;)
+	{
+		sl = sizeof(ss);
+		rd = recvfrom(fd, udpbuf+S5_UDP_HDR_MAX, UDP_BUF_SIZE, 0, (struct sockaddr*)&ss, &sl);
+		if (rd<0) break;
+		if (!ua->client_port_known) continue; // nowhere to send
+		sa46copy(&src,(struct sockaddr*)&ss);
+		sa46_unmap(&src);
+		{
+			struct udp_flow *f;
+			for (f=ua->flows;f;f=f->next)
+				if (sa46_eq(&f->dst,&src))
+				{
+					if (!f->in_count)
+					{
+						f->t_first_in_ms = zt_now_ms();
+						if (params.debug>=1)
+						{
+							char s[48];
+							ntop46_port((struct sockaddr*)&src,s,sizeof(s));
+							VPRINT("%s udp flow first reply : <- %s after %llums (out=%u before reply)\n",
+								zt_ts(), s, (unsigned long long)(f->t_first_in_ms - f->t_start_ms), f->out_count);
+						}
+					}
+					f->in_count++;
+					f->in_bytes += rd;
+					f->last = time(NULL);
+					break;
+				}
+		}
+		// build header right before payload
+		uint8_t hdr[S5_UDP_HDR_MAX];
+		hl = s5_udp_hdr(hdr,&src);
+		memcpy(udpbuf+S5_UDP_HDR_MAX-hl,hdr,hl);
+		if (sendto(ua->s[UDP_SOCK_RELAY].fd, udpbuf+S5_UDP_HDR_MAX-hl, hl+rd, 0, (struct sockaddr*)&ua->client, sa46len((struct sockaddr*)&ua->client))<0)
+			DBGPRINT("udp sendto (client) error %d\n",errno);
+		else
+			ua->pkt_in++;
+		ua->last = time(NULL);
+	}
+}
+
+bool udp_handle_event(struct udp_sock *us, uint32_t events)
+{
+	struct udp_assoc *ua = us->ua;
+
+	if (!(events & EPOLLIN)) return true;
+	if (us->kind==UDP_SOCK_RELAY)
+	{
+		struct sockaddr_storage ss;
+		socklen_t sl;
+		ssize_t rd;
+		sockaddr_in46 from;
+
+		for(;;)
+		{
+			sl = sizeof(ss);
+			rd = recvfrom(us->fd, udpbuf, UDP_BUF_SIZE, 0, (struct sockaddr*)&ss, &sl);
+			if (rd<0) break;
+			ua->last = time(NULL);
+			sa46copy(&from,(struct sockaddr*)&ss);
+			udp_from_client(ua, udpbuf, (size_t)rd, &from);
+		}
+	}
+	else
+		udp_from_remote(ua, us->fd);
+
+	if (ua->flow_count>UDP_MAX_FLOWS/2) udp_flows_gc(ua,time(NULL));
+	return true;
+}
diff --git a/tpws/udp.h b/tpws/udp.h
new file mode 100644
index 0000000..9bcfccd
--- /dev/null
+++ b/tpws/udp.h
@@ -0,0 +1,92 @@
+#pragma once
+
+// SOCKS5 UDP ASSOCIATE support for tpws
+// works without root : DPI desync is done by sending fake datagrams with low TTL/hoplimit
+// before the real ones (setsockopt IP_TTL / IPV6_UNICAST_HOPS are unprivileged)
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <time.h>
+#include <sys/socket.h>
+#include "helpers.h"
+
+#define UDP_DEFAULT_TIMEOUT	60
+#define UDP_MAX_FLOWS		512
+#define UDP_EV_TAG		((uintptr_t)1)	// low bit of epoll data.ptr marks udp sockets
+
+struct udp_assoc;
+
+enum { UDP_SOCK_RELAY=0, UDP_SOCK_OUT4, UDP_SOCK_OUT6, UDP_SOCK_COUNT };
+
+struct udp_sock
+{
+	struct udp_assoc *ua;
+	int fd;
+	int kind;
+};
+
+enum { UDP_PROTO_UNKNOWN=0, UDP_PROTO_QUIC, UDP_PROTO_DISCORD, UDP_PROTO_STUN };
+
+struct udp_flow
+{
+	sockaddr_in46 dst;
+	time_t last;
+	unsigned int out_count;		// datagrams sent (used for desync count)
+	unsigned int in_count;		// datagrams received from dst
+	uint64_t out_bytes, in_bytes;
+	uint8_t proto;			// detected from first datagram
+	uint64_t t_start_ms, t_first_in_ms;	// monotonic ms: first datagram out, first datagram in (0 = none)
+	unsigned int disc_sent;		// discord ip discovery requests sent (>1 means client retried)
+	unsigned int fakes;		// fakes sent in this flow
+	struct udp_flow *next;
+};
+
+#define UDP_PENDING_PKTS	16	// datagrams buffered per domain while resolving
+#define UDP_PENDING_DOMS	8	// domains being resolved per association
+
+struct resolve_item;
+struct udp_pending
+{
+	struct udp_assoc *ua;
+	struct resolve_item *ri;	// in-flight resolve. ri->ptr points back here (tagged)
+	char dom[256];
+	int count;
+	struct {
+		uint8_t *data;
+		size_t len;
+		uint16_t port;		// network order
+	} pkt[UDP_PENDING_PKTS];
+	struct udp_pending *next;
+};
+
+struct udp_assoc
+{
+	void *ctl;		// tproxy_conn_t* of the controlling TCP connection
+	int efd;
+	struct udp_sock s[UDP_SOCK_COUNT];
+	sockaddr_in46 client;	// client udp address. ip is taken from tcp peer, port learned or given in request
+	bool client_port_known;
+	time_t last;
+	uint64_t pkt_out, pkt_in, fakes;
+	struct udp_flow *flows;
+	unsigned int flow_count;
+	struct udp_pending *pending;
+	unsigned int pending_count;
+};
+
+// create association. ctl_fd - tcp control socket. req_port - DST.PORT from request (network order, 0 = unknown)
+// on success fills bnd with relay address to report to the client
+struct udp_assoc *udp_assoc_create(void *ctl, int efd, int ctl_fd, uint16_t req_port, struct sockaddr_storage *bnd);
+void udp_assoc_destroy(struct udp_assoc *ua);
+// returns false if association should be closed
+bool udp_handle_event(struct udp_sock *us, uint32_t events);
+bool udp_assoc_expired(const struct udp_assoc *ua, time_t now);
+// monotonic milliseconds and wall clock "HH:MM:SS.mmm" for timing logs
+uint64_t zt_now_ms(void);
+const char *zt_ts(void);
+
+// called from main loop when resolver finishes an item whose ptr is udp-tagged. does not free ri.
+void udp_resolve_complete(struct resolve_item *ri);
+
+static inline bool udp_ev_is(const void *ptr) { return ((uintptr_t)ptr) & UDP_EV_TAG; }
+static inline struct udp_sock *udp_ev_ptr(void *ptr) { return (struct udp_sock*)(((uintptr_t)ptr) & ~UDP_EV_TAG); }
