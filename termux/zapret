            5) add_strategy ;;
            6) toggle_udp ;;
            7) set_udp_profile ;;
            8) change_port ;;
            9) toggle_hostlist ;;
            10) select_hostlist_file ;;
            11) if grep -q "zapret start" "$BASHRC" 2>/dev/null; then disable_autostart; else enable_autostart; fi ;;
            12) install_zapret ;;
            13) update_zapret ;;
            14) read -p "Точно удалить? (y/n) " -n 1 -r; echo; [[ $REPLY =~ ^[Yy]$ ]] && remove_zapret ;;
            15) debug_zapret ;;
            0|q) exit 0 ;;
            *) echo -e "${RED}Неверный выбор.${NC}" ;;
        esac
        press_any_key
    done
}

show_help() {
    cat <<HELP
Использование: zapret [команда]

  (без аргументов) | menu      интерактивное меню
  start | stop | restart | status | info
  strategies                   список TCP-стратегий
  strategy <name>              выбрать TCP-стратегию
  set-port <port> [-y]         сменить порт SOCKS
  hostlist [-y]                вкл/выкл hostlist
  hostlist-list | hostlist-check
  hostlist-select <file>
  udp on|off|toggle            UDP через SOCKS5 UDP ASSOCIATE
  udp-profiles                 список UDP-профилей
  udp-profile <name>           выбрать UDP-профиль
  udp-custom "<параметры>"     свой UDP-профиль
  autostart on|off
  install | update | remove
  cmd                          показать итоговую команду tpws
  debug                        запустить с логом (Ctrl+C - стоп), показать сводку UDP
HELP
}

# -------------------------------------------------------------------
# main
# -------------------------------------------------------------------
load_strategies
init_udp_profiles

case "$1" in
    ""|menu)        show_menu ;;
    start)          start_zapret ;;
    stop)           stop_zapret ;;
    restart)        restart_zapret ;;
    status)         status_zapret ;;
    info)           info_zapret ;;
    cmd)            get_command ;;
    debug)          debug_zapret ;;
    strategies)     list_strategies ;;
    strategy)
        if [[ -n "$2" && -n "${STRATEGIES[$2]}" ]]; then
            echo "$2" > "$STRATEGY_FILE"
            echo -e "${GREEN}Стратегия: $2${NC}"
            restart_if_running
        else
            echo -e "${RED}Нет стратегии '$2'.${NC}" >&2; exit 1
        fi ;;
    set-port)       change_port "$2" "$3" ;;
    hostlist)       toggle_hostlist "$2" ;;
    hostlist-list)  list_hostlist_files ;;
    hostlist-check) check_hostlist ;;
    hostlist-select) select_hostlist_file "$2" ;;
    udp)
        case "$2" in
            on)  [[ "$(get_use_udp)" == "1" ]] && echo -e "${YELLOW}UDP уже включён.${NC}" || toggle_udp ;;
            off) [[ "$(get_use_udp)" == "0" ]] && echo -e "${YELLOW}UDP уже выключен.${NC}" || toggle_udp ;;
            ""|toggle) toggle_udp ;;
            *) echo "Use: udp on|off|toggle" >&2; exit 1 ;;
        esac ;;
    udp-profiles)   for n in "${UDP_PROFILE_NAMES[@]}"; do echo "$n"; done ;;
    udp-profile)    set_udp_profile "$2" ;;
    udp-custom)     shift; set_udp_custom "$@" ;;
    autostart)
        case "$2" in
            on)  enable_autostart ;;
            off) disable_autostart ;;
            *) echo "Use: autostart on|off" >&2; exit 1 ;;
        esac ;;
    install)        install_zapret ;;
    update)         update_zapret ;;
    remove)         remove_zapret ;;
    help|-h|--help) show_help ;;
    *)              show_help; exit 1 ;;
esac
