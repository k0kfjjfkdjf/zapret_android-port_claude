#!/usr/bin/env bash
# ============================================
# zapret-termux: tpws (zapret) как SOCKS5-прокси в Termux + proot-distro, без root
# Установка:  sh -c "$(curl -fsSL https://raw.githubusercontent.com/k0kfjjfkdjf/zapret_android-port_claude/termux-zapret-udp-script/termux/install.sh)"
# ============================================

ZT_HOME="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

for _m in common udp strategies process config build lists blockcheck debug menu; do
    # shellcheck source=/dev/null
    source "$ZT_HOME/lib/$_m.sh" || { echo "zapret: не найден модуль $ZT_HOME/lib/$_m.sh" >&2; exit 1; }
done
unset _m

# -------------------------------------------------------------------
# main
# -------------------------------------------------------------------
load_strategies
init_udp_profiles

case "$1" in
    ""|menu)        show_menu ;;
    start)          start_zapret ;;
    stop)           stop_zapret ;;
    restart)        restart_zapret ;;
    status)         status_zapret ;;
    info)           info_zapret ;;
    cmd)            get_command ;;
    debug)          debug_zapret ;;
    blockcheck)     shift; blockcheck_zapret "$@" ;;
    lists-update)   update_lists ;;
    strategies)     list_strategies ;;
    strategy)
        if [[ -n "$2" && -n "${STRATEGIES[$2]}" ]]; then
            echo "$2" > "$STRATEGY_FILE"
            echo -e "${GREEN}Стратегия: $2${NC}"
            restart_if_running
        else
            echo -e "${RED}Нет стратегии '$2'.${NC}" >&2; exit 1
        fi ;;
    set-port)       change_port "$2" "$3" ;;
    hostlist)       toggle_hostlist "$2" ;;
    hostlist-list)  list_hostlist_files ;;
    hostlist-check) check_hostlist ;;
    hostlist-select) select_hostlist_file "$2" ;;
    udp)
        case "$2" in
            on)  [[ "$(get_use_udp)" == "1" ]] && echo -e "${YELLOW}UDP уже включён.${NC}" || toggle_udp ;;
            off) [[ "$(get_use_udp)" == "0" ]] && echo -e "${YELLOW}UDP уже выключен.${NC}" || toggle_udp ;;
            ""|toggle) toggle_udp ;;
            *) echo "Use: udp on|off|toggle" >&2; exit 1 ;;
        esac ;;
    udp-profiles)   for n in "${UDP_PROFILE_NAMES[@]}"; do echo "$n"; done ;;
    udp-profile)    set_udp_profile "$2" ;;
    udp-custom)     shift; set_udp_custom "$@" ;;
    autostart)
        case "$2" in
            on)  enable_autostart ;;
            off) disable_autostart ;;
            *) echo "Use: autostart on|off" >&2; exit 1 ;;
        esac ;;
    install)        install_zapret ;;
    update)         update_zapret ;;
    remove)         remove_zapret ;;
    version)        zt_version ;;
    help|-h|--help) show_help ;;
    *)              show_help; exit 1 ;;
esac
