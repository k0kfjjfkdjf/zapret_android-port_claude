#!/usr/bin/env bash

# ============================================
# Управление zapret (SOCKS5/tpws) в Termux+proot
# ============================================

ZAPRET_DIR="/opt/zapret"
TPWS_BIN="$ZAPRET_DIR/tpws/tpws"
STRATEGY_FILE="$HOME/.zapret_strategy"
STRATEGIES_FILE="$HOME/.zapret_strategies"
BASHRC="$HOME/.bashrc"
SCRIPT_PATH="/usr/local/bin/zapret"

PORT_FILE="$HOME/.zapret_port"
HOSTLIST_FILE="$HOME/.zapret_use_hostlist"
HOSTLIST_SELECT_FILE="$HOME/.zapret_selected_hostlist"
HOSTLIST_DIR="$ZAPRET_DIR/ipset"

UDP_FILE="$HOME/.zapret_use_udp"
UDP_PROFILE_FILE="$HOME/.zapret_udp_profile"
UDP_CUSTOM_FILE="$HOME/.zapret_udp_custom"
FAKE_DIR="$ZAPRET_DIR/files/fake"
ZAPRET_REPO="https://github.com/bol-van/zapret.git"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

declare -A STRATEGIES
declare -a STRATEGY_NAMES
INTERACTIVE=0   # 1 — меню, 0 — CLI (без вопросов)

# -------------------------------------------------------------------
# Вспомогательные функции
# -------------------------------------------------------------------
press_any_key() {
    echo ""
    read -n 1 -s -r -p "Нажмите любую клавишу для продолжения..."
    echo ""
}

run_with_sudo() {
    if [[ $EUID -eq 0 ]]; then
        "$@"
    elif command -v sudo &>/dev/null; then
        sudo "$@"
    else
        echo -e "${RED}Ошибка: требуется sudo, но он не установлен.${NC}"
        return 1
    fi
}

can_write_to_dir() {
    local dir="$1"
    if [[ -d "$dir" && -w "$dir" ]] || [[ ! -d "$dir" && -w "$(dirname "$dir")" ]]; then
        return 0
    else
        return 1
    fi
}

is_zapret_installed() {
    [[ -f "$TPWS_BIN" ]]
}

# -------------------------------------------------------------------
# Настройки порта и hostlist
# -------------------------------------------------------------------
get_current_port() {
    if [[ -f "$PORT_FILE" ]]; then
        cat "$PORT_FILE"
    else
        echo "1080" > "$PORT_FILE"
        echo "1080"
    fi
}

set_port() {
    echo "$1" > "$PORT_FILE"
}

get_use_hostlist() {
    if [[ -f "$HOSTLIST_FILE" ]]; then
        cat "$HOSTLIST_FILE"
    else
        echo "0" > "$HOSTLIST_FILE"
        echo "0"
    fi
}

set_use_hostlist() {
    echo "$1" > "$HOSTLIST_FILE"
}

get_selected_hostlist() {
    if [[ -f "$HOSTLIST_SELECT_FILE" ]]; then
        cat "$HOSTLIST_SELECT_FILE"
    else
        echo ""
    fi
}

set_selected_hostlist() {
    echo "$1" > "$HOSTLIST_SELECT_FILE"
}

get_hostlist_files() {
    if [[ -d "$HOSTLIST_DIR" ]]; then
        find "$HOSTLIST_DIR" -maxdepth 1 -type f -printf "%f\n" 2>/dev/null | sort
    else
        echo ""
    fi
}

# -------------------------------------------------------------------
# UDP (SOCKS5 UDP ASSOCIATE, нужен патченый tpws)
# -------------------------------------------------------------------
declare -A UDP_PROFILES
declare -a UDP_PROFILE_NAMES

init_udp_profiles() {
    local q="--udp-fake-quic=$FAKE_DIR/quic_initial_www_google_com.bin"
    local fk="$q --udp-fake-discord=$FAKE_DIR/discord-ip-discovery-with-port.bin --udp-fake-stun=$FAKE_DIR/stun.bin"
    # порты голоса Discord: 19294-19344 и 50000-65535, 3478 - STUN
    local dports="443,3478,19294-19344,50000-65535"
    UDP_PROFILES=(
        ["relay"]=""
        ["discord"]="--udp-desync-ports=$dports --udp-fake-ttl=4 --udp-fake-repeats=6 --udp-desync-count=4 $fk"
        ["discord_low_ttl"]="--udp-desync-ports=$dports --udp-fake-ttl=2 --udp-fake-repeats=8 --udp-desync-count=6 $fk"
        ["discord_high_ttl"]="--udp-desync-ports=$dports --udp-fake-ttl=6 --udp-fake-repeats=6 --udp-desync-count=4 $fk"
        ["quic"]="--udp-desync-ports=443 --udp-fake-ttl=4 --udp-fake-repeats=6 --udp-desync-count=2 $q"
        ["all_ports"]="--udp-fake-ttl=4 --udp-fake-repeats=6 --udp-desync-count=4 $fk"
    )
    UDP_PROFILE_NAMES=("discord" "discord_low_ttl" "discord_high_ttl" "quic" "all_ports" "relay")
    if [[ -f "$UDP_CUSTOM_FILE" ]] && [[ -n "$(cat "$UDP_CUSTOM_FILE")" ]]; then
        UDP_PROFILES["custom"]="$(cat "$UDP_CUSTOM_FILE")"
        UDP_PROFILE_NAMES+=("custom")
    fi
}

get_use_udp() {
    if [[ -f "$UDP_FILE" ]]; then
        cat "$UDP_FILE"
    else
        echo "0"
    fi
}

set_use_udp() {
    echo "$1" > "$UDP_FILE"
}

get_udp_profile() {
    local p="discord"
    [[ -f "$UDP_PROFILE_FILE" ]] && p=$(cat "$UDP_PROFILE_FILE")
    [[ "$p" == "quic_discord" || "$p" == "low_ttl" ]] && p="discord"   # профили старой версии
    [[ -z "${UDP_PROFILES[$p]+x}" ]] && p="discord"
    echo "$p"
}

tpws_supports_udp() {
    [[ -x "$TPWS_BIN" ]] && "$TPWS_BIN" --help 2>&1 | grep -q -- "--socks-udp"
}

restart_if_running() {
    if pgrep -f "tpws.*--socks" > /dev/null; then
        restart_zapret
    fi
}

toggle_udp() {
    if [[ "$(get_use_udp)" == "1" ]]; then
        set_use_udp "0"
        echo -e "${GREEN}UDP выключен.${NC}"
    else
        if ! tpws_supports_udp; then
            echo -e "${RED}Установленный tpws не поддерживает UDP. Выполните: zapret update${NC}" >&2
            return 1
        fi
        set_use_udp "1"
        echo -e "${GREEN}UDP включён (профиль: $(get_udp_profile)).${NC}"
    fi
    restart_if_running
}

set_udp_profile() {
    local name="$1"
    if [[ -z "$name" ]]; then
        if [[ $INTERACTIVE -eq 0 ]]; then
            echo "Error: profile name required. Use: udp-profile <name>" >&2
            return 1
        fi
        echo -e "${BLUE}UDP-профили:${NC}"
        local i=1 cur
        cur=$(get_udp_profile)
        for n in "${UDP_PROFILE_NAMES[@]}"; do
            if [[ "$n" == "$cur" ]]; then
                echo -e "  $i) $n ${GREEN}(текущий)${NC}"
            else
                echo "  $i) $n"
            fi
            echo "       ${UDP_PROFILES[$n]:-(без десинхронизации, только проксирование)}"
            ((i++))
        done
        echo "  $i) задать свои параметры (custom)"
        read -p "Номер (0 для отмены): " num
        [[ "$num" == "0" || -z "$num" ]] && return 0
        if [[ "$num" == "$i" ]]; then
            echo "Пример: --udp-desync-ports=443 --udp-fake-ttl=5 --udp-fake-repeats=4"
            read -p "Параметры: " custom
            custom=$(echo "$custom" | xargs)
            [[ -z "$custom" ]] && { echo -e "${RED}Пусто.${NC}"; return 1; }
            echo "$custom" > "$UDP_CUSTOM_FILE"
            init_udp_profiles
            name="custom"
        elif [[ "$num" =~ ^[0-9]+$ ]] && (( num >= 1 && num < i )); then
            name="${UDP_PROFILE_NAMES[$((num-1))]}"
        else
            echo -e "${RED}Неверный номер.${NC}"
            return 1
        fi
    fi
    if [[ -z "${UDP_PROFILES[$name]+x}" ]]; then
        echo -e "${RED}Нет UDP-профиля '$name'. Доступны: ${UDP_PROFILE_NAMES[*]}${NC}" >&2
        return 1
    fi
    echo "$name" > "$UDP_PROFILE_FILE"
    echo -e "${GREEN}UDP-профиль: $name${NC}"
    [[ "$(get_use_udp)" == "1" ]] && restart_if_running
    return 0
}

set_udp_custom() {
    local params="$*"
    if [[ -z "$params" ]]; then
        echo "Error: use: udp-custom \"--udp-fake-ttl=5 ...\"" >&2
        return 1
    fi
    echo "$params" > "$UDP_CUSTOM_FILE"
    init_udp_profiles
    set_udp_profile custom
}

# -------------------------------------------------------------------
# Управление стратегиями
# -------------------------------------------------------------------
create_default_strategies() {
    STRATEGIES=(
        ["default"]="--filter-tcp=80,443 --split-pos=1,midsld --disorder"
        ["oob"]="--filter-tcp=80,443 --split-pos=1,midsld --disorder --oob"
        ["simple"]="--filter-tcp=80,443 --split-pos=1 --disorder"
        ["advanced"]="--filter-tcp=80,443 --split-pos=1,3,5,7,9 --disorder --oob"
        ["discord"]="--filter-tcp=80,443 --split-pos=1,sniext+1,host+1,midsld-2,midsld,midsld+2,endhost-1 --disorder --oob"
        ["discord_ultimate"]="--filter-tcp=80,443 --split-pos=1,sniext,sniext+1,sniext+2,host,host+1,host+2,midsld,midsld+1,midsld+2,endhost-2,endhost-1,endhost --oob --disorder --tlsrec=sniext+1,sniext+2,sniext+3"
        ["ultimate_universal"]="--filter-tcp=80 --split-pos=host,host+1,host+2,endhost-1,endhost --oob --disorder --methodspace --methodeol --hostcase --new --filter-tcp=443 --split-pos=1,sniext,sniext+1,sniext+2,midsld,midsld+1,midsld+2,endhost-1,endhost --oob --disorder --tlsrec=sniext+1,sniext+2"
        ["aggressive_16"]="--filter-tcp=80 --split-pos=host,host+1,host+2,endhost-2,endhost-1,endhost --oob --disorder --methodspace --methodeol --hostcase --filter-tcp=443 --split-pos=1,sniext,sniext+1,sniext+2,midsld,midsld+1,midsld+2,endhost-2,endhost-1,endhost --oob --disorder"
        ["classic_advanced"]="--filter-tcp=80,443 --split-pos=1,2,3,4,5,6,7,8 --disorder --oob"
    )
    STRATEGY_NAMES=(
        "default" "oob" "simple" "advanced" "discord" "discord_ultimate"
        "ultimate_universal" "aggressive_16" "classic_advanced"
    )
}

save_strategies() {
    > "$STRATEGIES_FILE"
    for name in "${STRATEGY_NAMES[@]}"; do
        echo "$name|${STRATEGIES[$name]}" >> "$STRATEGIES_FILE"
    done
}

load_strategies() {
    STRATEGIES=()
    STRATEGY_NAMES=()
    if [[ -f "$STRATEGIES_FILE" ]]; then
        while IFS='|' read -r name params; do
            name=$(echo "$name" | xargs)
            params=$(echo "$params" | xargs)
            if [[ -n "$name" && -n "$params" ]]; then
                STRATEGIES["$name"]="$params"
                STRATEGY_NAMES+=("$name")
            fi
        done < "$STRATEGIES_FILE"
    else
        create_default_strategies
        save_strategies
    fi
}

get_current_strategy_name() {
    if [[ -f "$STRATEGY_FILE" ]]; then
        cat "$STRATEGY_FILE"
    else
        echo "${STRATEGY_NAMES[0]:-default}" > "$STRATEGY_FILE"
        cat "$STRATEGY_FILE"
    fi
}

get_command() {
    local strategy
    strategy=$(get_current_strategy_name)
    if [[ -z "${STRATEGIES[$strategy]}" ]]; then
        strategy="${STRATEGY_NAMES[0]:-default}"
        echo "$strategy" > "$STRATEGY_FILE"
    fi

    local port
    port=$(get_current_port)
    local cmd="$TPWS_BIN --port=$port --bind-addr=127.0.0.1 --socks ${STRATEGIES[$strategy]} --daemon"

    if [[ "$(get_use_udp)" == "1" ]]; then
        if tpws_supports_udp; then
            cmd="$cmd --socks-udp ${UDP_PROFILES[$(get_udp_profile)]}"
        else
            >&2 echo -e "${YELLOW}Warning: UDP включён, но tpws собран без поддержки UDP (zapret update)${NC}"
        fi
    fi

    if [[ "$(get_use_hostlist)" == "1" ]]; then
        local selected
        selected=$(get_selected_hostlist)
        if [[ -n "$selected" && -f "$HOSTLIST_DIR/$selected" ]]; then
            cmd="$cmd --hostlist=$HOSTLIST_DIR/$selected"
        else
            # Если выбранного файла нет, попробуем взять первый попавшийся
            local first_file
            first_file=$(get_hostlist_files | head -1)
            if [[ -n "$first_file" ]]; then
                set_selected_hostlist "$first_file"
                cmd="$cmd --hostlist=$HOSTLIST_DIR/$first_file"
            else
                # Нет ни одного файла — просто игнорируем hostlist
                >&2 echo -e "${YELLOW}Warning: hostlist enabled but no files found in $HOSTLIST_DIR${NC}"
            fi
        fi
    fi

    echo "$cmd"
}

# -------------------------------------------------------------------
# Управление процессом
# -------------------------------------------------------------------
start_zapret() {
    if ! is_zapret_installed; then
        echo -e "${RED}Ошибка: zapret не установлен.${NC}"
        return 1
    fi

    if pgrep -f "tpws.*--socks" > /dev/null; then
        echo -e "${YELLOW}Zapret уже запущен.${NC}"
    else
        local cmd
        cmd=$(get_command)
        eval "$cmd &>/dev/null"
        if pgrep -f "tpws.*--socks" > /dev/null; then
            echo -e "${GREEN}Zapret запущен с стратегией '$(get_current_strategy_name)' на порту $(get_current_port)${NC}"
        else
            echo -e "${RED}Ошибка при запуске tpws.${NC}"
        fi
    fi
}

stop_zapret() {
    if pgrep -f "tpws.*--socks" > /dev/null; then
        pkill -f "tpws.*--socks"
        echo -e "${GREEN}Zapret остановлен.${NC}"
    else
        echo -e "${YELLOW}Zapret не запущен.${NC}"
    fi
}

restart_zapret() {
    stop_zapret
    sleep 1
    start_zapret
}

status_zapret() {
    echo -e "${BLUE}═════════════════════════════════════════════════${NC}"
    if pgrep -f "tpws.*--socks" > /dev/null; then
        local pid
        pid=$(pgrep -f "tpws.*--socks" | head -1)
        echo -e "Статус:             ${GREEN}Запущен${NC} (PID: $pid)"
    else
        echo -e "Статус:             ${RED}Остановлен${NC}"
    fi

    if grep -q "zapret start" "$BASHRC" 2>/dev/null; then
        echo -e "Автозапуск:         ${GREEN}Включён${NC}"
    else
        echo -e "Автозапуск:         ${RED}Выключен${NC}"
    fi

    echo -e "Текущая стратегия:  ${YELLOW}$(get_current_strategy_name)${NC}"
    echo -e "Порт:               ${YELLOW}$(get_current_port)${NC}"
    
    if [[ "$(get_use_hostlist)" == "1" ]]; then
        local sel
        sel=$(get_selected_hostlist)
        if [[ -n "$sel" ]]; then
            echo -e "Hostlist:           ${GREEN}Включён${NC} (файл: $sel)"
        else
            echo -e "Hostlist:           ${YELLOW}Включён, но файл не выбран${NC}"
        fi
    else
        echo -e "Hostlist:           ${RED}Выключен${NC}"
    fi

    if [[ "$(get_use_udp)" == "1" ]]; then
        echo -e "UDP:                ${GREEN}Включён${NC} (профиль: $(get_udp_profile))"
    else
        echo -e "UDP:                ${RED}Выключен${NC}"
    fi
    if ! tpws_supports_udp && is_zapret_installed; then
        echo -e "                    ${YELLOW}tpws без поддержки UDP, нужен zapret update${NC}"
    fi
    echo -e "${BLUE}═════════════════════════════════════════════════${NC}"
}

# -------------------------------------------------------------------
# Новые функции для автоматизации
# -------------------------------------------------------------------
list_strategies() {
    for name in "${STRATEGY_NAMES[@]}"; do
        echo "$name"
    done
}

info_zapret() {
    local running=0
    local pid=""
    if pgrep -f "tpws.*--socks" > /dev/null; then
        running=1
        pid=$(pgrep -f "tpws.*--socks" | head -1)
    fi

    echo "status=$running"
    echo "pid=$pid"
    echo "bind_addr=127.0.0.1"
    echo "port=$(get_current_port)"
    echo "strategy=$(get_current_strategy_name)"
    echo "hostlist=$(get_use_hostlist)"
    echo "hostlist_file=$(get_selected_hostlist)"
    echo "autostart=$(grep -q "zapret start" "$BASHRC" 2>/dev/null && echo "1" || echo "0")"
    echo "udp=$(get_use_udp)"
    echo "udp_profile=$(get_udp_profile)"
    echo "udp_supported=$(tpws_supports_udp && echo 1 || echo 0)"
}

list_hostlist_files() {
    local files
    files=$(get_hostlist_files)
    if [[ -z "$files" ]]; then
        echo -e "${YELLOW}No hostlist files found in $HOSTLIST_DIR${NC}" >&2
        return 1
    else
        echo "$files"
        return 0
    fi
}

check_hostlist() {
    local files
    files=$(get_hostlist_files)
    if [[ -z "$files" ]]; then
        echo -e "${RED}No hostlist files found in $HOSTLIST_DIR${NC}"
        return 1
    else
        echo -e "${GREEN}Available hostlist files:${NC}"
        local i=1
        local selected
        selected=$(get_selected_hostlist)
        for f in $files; do
            if [[ "$f" == "$selected" ]]; then
                echo -e "  $i) $f ${GREEN}(current)${NC}"
            else
                echo "  $i) $f"
            fi
            ((i++))
        done
        return 0
    fi
}

select_hostlist_file() {
    local choice="$1"
    if [[ -z "$choice" ]]; then
        if [[ $INTERACTIVE -eq 0 ]]; then
            echo "Error: no hostlist file specified. Use: hostlist-select <filename>" >&2
            return 1
        fi
        echo -e "${BLUE}Available files:${NC}"
        local files
        files=$(get_hostlist_files)
        if [[ -z "$files" ]]; then
            echo -e "${RED}No files in $HOSTLIST_DIR${NC}"
            return 1
        fi
        local i=1
        for f in $files; do
            echo "  $i) $f"
            ((i++))
        done
        read -p "Select file number (0 to cancel): " num
        if [[ "$num" == "0" || -z "$num" ]]; then
            return 0
        fi
        if [[ "$num" =~ ^[0-9]+$ ]]; then
            local file_name
            file_name=$(echo "$files" | sed -n "${num}p")
            if [[ -n "$file_name" ]]; then
                set_selected_hostlist "$file_name"
                echo -e "${GREEN}Selected: $file_name${NC}"
                if pgrep -f "tpws.*--socks" > /dev/null; then
                    if [[ $INTERACTIVE -eq 1 ]]; then
                        read -p "Restart zapret now? (y/n) " -n 1 -r
                        echo
                        if [[ $REPLY =~ ^[Yy]$ ]]; then
                            restart_zapret
                        fi
                    else
                        restart_zapret
                    fi
                fi
                return 0
            fi
        fi
        echo -e "${RED}Invalid selection.${NC}"
        return 1
    else
        # Non‑interactive: select by exact filename
        if [[ -f "$HOSTLIST_DIR/$choice" ]]; then
            set_selected_hostlist "$choice"
            echo -e "${GREEN}Selected: $choice${NC}"
            if pgrep -f "tpws.*--socks" > /dev/null; then
                restart_zapret
            fi
            return 0
        else
            echo -e "${RED}Error: file '$choice' not found in $HOSTLIST_DIR${NC}" >&2
            return 1
        fi
    fi
}

# -------------------------------------------------------------------
# Автозапуск
# -------------------------------------------------------------------
enable_autostart() {
    if ! grep -q "zapret start" "$BASHRC" 2>/dev/null; then
        echo "" >> "$BASHRC"
        echo "# Автозапуск zapret" >> "$BASHRC"
        echo "if ! pgrep -f 'tpws.*--socks' > /dev/null; then $SCRIPT_PATH start; fi" >> "$BASHRC"
        echo -e "${GREEN}Автозапуск включён.${NC}"
    else
        echo -e "${YELLOW}Автозапуск уже включён.${NC}"
    fi
}

disable_autostart() {
    if grep -q "zapret start" "$BASHRC" 2>/dev/null; then
        sed -i '/# Автозапуск zapret/d' "$BASHRC"
        sed -i '/pgrep.*tpws.*--socks.*zapret start/d' "$BASHRC"
        echo -e "${GREEN}Автозапуск отключён.${NC}"
    else
        echo -e "${YELLOW}Автозапуск не был включён.${NC}"
    fi
}

# -------------------------------------------------------------------
# Меню выбора и создания стратегий
# -------------------------------------------------------------------
add_strategy() {
    echo -e "${BLUE}Добавление новой стратегии${NC}"
    read -p "Введите имя стратегии: " new_name
    new_name=$(echo "$new_name" | xargs)
    
    if [[ -z "$new_name" ]]; then
        echo -e "${RED}Имя не может быть пустым.${NC}"
        return 1
    fi
    if [[ -n "${STRATEGIES[$new_name]}" ]]; then
        echo -e "${RED}Стратегия с таким именем уже существует.${NC}"
        return 1
    fi

    echo "Введите параметры для tpws (например: --filter-tcp=80,443 --split-pos=1,midsld --disorder)"
    read -p "Параметры: " new_params
    new_params=$(echo "$new_params" | xargs)
    
    if [[ -z "$new_params" ]]; then
        echo -e "${RED}Параметры не могут быть пустыми.${NC}"
        return 1
    fi

    STRATEGIES["$new_name"]="$new_params"
    STRATEGY_NAMES+=("$new_name")
    save_strategies
    echo -e "${GREEN}Стратегия '$new_name' добавлена.${NC}"
}

select_strategy() {
    echo -e "${BLUE}Доступные стратегии:${NC}"
    local i=1
    for name in "${STRATEGY_NAMES[@]}"; do
        echo "  $i) $name"
        ((i++))
    done
    echo ""
    read -p "Выберите номер стратегии (0 для отмены): " num
    if [[ "$num" == "0" || -z "$num" ]]; then
        return 0
    fi

    if [[ "$num" =~ ^[0-9]+$ ]] && (( num >= 1 && num <= ${#STRATEGY_NAMES[@]} )); then
        local selected="${STRATEGY_NAMES[$((num-1))]}"
        echo "$selected" > "$STRATEGY_FILE"
        echo -e "${GREEN}Текущая стратегия изменена на '$selected'${NC}"
        if pgrep -f "tpws.*--socks" > /dev/null; then
            restart_zapret
        fi
    else
        echo -e "${RED}Неверный номер.${NC}"
    fi
}

# -------------------------------------------------------------------
# Конфигурация порта и hostlist (с поддержкой -y)
# -------------------------------------------------------------------
change_port() {
    local new_port="$1"
    local force="$2"
    if [[ -z "$new_port" ]]; then
        if [[ $INTERACTIVE -eq 0 ]]; then
            echo "Error: port number required. Use: set-port <port> [-y]" >&2
            return 1
        fi
        echo -e "${BLUE}Текущий порт: $(get_current_port)${NC}"
        read -p "Введите новый номер порта (1025-65535): " new_port
    fi

    if [[ "$new_port" =~ ^[0-9]+$ ]] && (( new_port >= 1025 && new_port <= 65535 )); then
        set_port "$new_port"
        echo -e "${GREEN}Порт изменён на $new_port${NC}"
        if pgrep -f "tpws.*--socks" > /dev/null; then
            if [[ "$force" == "-y" || "$force" == "--yes" ]]; then
                restart_zapret
            elif [[ $INTERACTIVE -eq 1 ]]; then
                read -p "Перезапустить zapret сейчас? (y/n) " -n 1 -r
                echo
                if [[ $REPLY =~ ^[Yy]$ ]]; then
                    restart_zapret
                fi
            else
                echo -e "${YELLOW}Порт изменён. Для применения перезапустите zapret (restart) или используйте -y.${NC}"
            fi
        fi
    else
        echo -e "${RED}Неверный порт. Допустимы значения от 1025 до 65535.${NC}"
        return 1
    fi
}

toggle_hostlist() {
    local force="$1"
    local current
    current=$(get_use_hostlist)

    if [[ "$current" == "1" ]]; then
        set_use_hostlist "0"
        echo -e "${GREEN}Hostlist disabled.${NC}"
        # Перезапускаем только если процесс запущен и мы в неинтерактивном режиме
        if pgrep -f "tpws.*--socks" > /dev/null; then
            if [[ "$force" == "-y" || "$force" == "--yes" ]] || [[ $INTERACTIVE -eq 0 ]]; then
                restart_zapret
            else
                read -p "Restart zapret now? (y/n) " -n 1 -r
                echo
                if [[ $REPLY =~ ^[Yy]$ ]]; then
                    restart_zapret
                fi
            fi
        fi
    else
        # Включаем hostlist
        local files
        files=$(get_hostlist_files)
        if [[ -z "$files" ]]; then
            echo -e "${RED}Error: no hostlist files found in $HOSTLIST_DIR${NC}" >&2
            return 1
        fi

        # Если нет выбранного файла, берём первый
        local selected
        selected=$(get_selected_hostlist)
        if [[ -z "$selected" || ! -f "$HOSTLIST_DIR/$selected" ]]; then
            selected=$(echo "$files" | head -1)
            set_selected_hostlist "$selected"
            echo -e "${YELLOW}No specific file selected, using: $selected${NC}"
        fi

        set_use_hostlist "1"
        echo -e "${GREEN}Hostlist enabled.${NC}"

        if pgrep -f "tpws.*--socks" > /dev/null; then
            if [[ "$force" == "-y" || "$force" == "--yes" ]] || [[ $INTERACTIVE -eq 0 ]]; then
                restart_zapret
            else
                read -p "Restart zapret now? (y/n) " -n 1 -r
                echo
                if [[ $REPLY =~ ^[Yy]$ ]]; then
                    restart_zapret
                fi
            fi
        fi
    fi
}

# -------------------------------------------------------------------
# Установка / Удаление / Обновление
# -------------------------------------------------------------------
remove_zapret() {
    echo -e "${YELLOW}Удаление zapret из $ZAPRET_DIR...${NC}"
    stop_zapret &>/dev/null
    disable_autostart &>/dev/null

    if [[ -d "$ZAPRET_DIR" ]]; then
        if can_write_to_dir "$ZAPRET_DIR"; then
            rm -rf "$ZAPRET_DIR"
        else
            run_with_sudo rm -rf "$ZAPRET_DIR" || {
                echo -e "${RED}Не удалось удалить $ZAPRET_DIR.${NC}"
                return 1
            }
        fi
        echo -e "${GREEN}Zapret удалён.${NC}"
    else
        echo -e "${YELLOW}Zapret не установлен.${NC}"
    fi
}


