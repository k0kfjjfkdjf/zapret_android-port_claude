apply_udp_patch() {
    local tmp
    tmp=$(mktemp)
    udp_patch_blob | base64 -d | gunzip > "$tmp" || {
        echo -e "${RED}Не удалось распаковать встроенный патч.${NC}"
        rm -f "$tmp"; return 1
    }
    if git -C "$ZAPRET_DIR" apply --check "$tmp" 2>/dev/null; then
        git -C "$ZAPRET_DIR" apply "$tmp"
    elif git -C "$ZAPRET_DIR" apply --3way "$tmp" 2>/dev/null; then
        echo -e "${YELLOW}Патч применён с 3-way слиянием (upstream изменился).${NC}"
    else
        echo -e "${RED}Патч UDP не накладывается на текущую версию zapret. Будет собран tpws без UDP.${NC}"
        rm -f "$tmp"; return 1
    fi
    rm -f "$tmp"
    echo -e "${GREEN}Патч UDP применён.${NC}"
}

build_tpws() {
    echo -e "${GREEN}Сборка tpws...${NC}"
    make -C "$ZAPRET_DIR/tpws" clean &>/dev/null
    if ! make -C "$ZAPRET_DIR/tpws" -j"$(nproc 2>/dev/null || echo 2)"; then
        echo -e "${RED}Ошибка сборки tpws.${NC}"
        return 1
    fi
    echo -e "${GREEN}tpws собран: $TPWS_BIN${NC}"
    tpws_supports_udp && echo -e "${GREEN}Поддержка UDP: есть${NC}" || echo -e "${YELLOW}Поддержка UDP: нет${NC}"
}

check_deps() {
    # tpws нужны компилятор, make, git, zlib и libcap (netfilter не нужен — это для nfqws)
    # учитываем голый rootfs proot-distro: там может не быть procps (pgrep/pkill) и ca-certificates
    local pm="" missing=()
    if command -v apt-get &>/dev/null; then pm="apt"
    elif command -v pacman &>/dev/null; then pm="pacman"
    elif command -v apk &>/dev/null; then pm="apk"
    fi

    case "$pm" in
        apt)
            local p
            for p in git make gcc libc6-dev zlib1g-dev libcap-dev procps ca-certificates gzip; do
                dpkg -s "$p" &>/dev/null || missing+=("$p")
            done ;;
        pacman)
            local p
            for p in git make gcc zlib libcap procps-ng ca-certificates gzip; do
                pacman -Q "$p" &>/dev/null || missing+=("$p")
            done ;;
        apk)
            local p
            for p in git make gcc musl-dev zlib-dev libcap-dev procps ca-certificates gzip coreutils bash; do
                apk info -e "$p" &>/dev/null || missing+=("$p")
            done ;;
        *)
            local c
            for c in git make gcc pgrep pkill base64 gunzip; do
                command -v "$c" &>/dev/null || missing+=("$c")
            done
            if [[ ${#missing[@]} -gt 0 ]]; then
                echo -e "${RED}Неизвестный пакетный менеджер. Установите вручную: ${missing[*]} + zlib и libcap (dev)${NC}"
                return 1
            fi
            return 0 ;;
    esac

    [[ ${#missing[@]} -eq 0 ]] && return 0

    echo -e "${YELLOW}Отсутствуют пакеты: ${missing[*]}${NC}"
    if [[ $INTERACTIVE -eq 1 ]]; then
        read -p "Установить их через $pm? (y/n) " -n 1 -r
        echo
        [[ $REPLY =~ ^[Yy]$ ]] || { echo -e "${RED}Установка прервана.${NC}"; return 1; }
    fi
    case "$pm" in
        apt)    run_with_sudo apt-get update && DEBIAN_FRONTEND=noninteractive run_with_sudo apt-get install -y "${missing[@]}" ;;
        pacman) run_with_sudo pacman -Sy --needed --noconfirm "${missing[@]}" ;;
        apk)    run_with_sudo apk add "${missing[@]}" ;;
    esac || {
        echo -e "${RED}Ошибка установки зависимостей.${NC}"
        return 1
    }
}

install_self() {
    local self
    self=$(readlink -f "$0")
    if [[ "$self" != "$SCRIPT_PATH" ]]; then
        # через временный файл + mv: работающий экземпляр bash продолжит читать старый файл
        if can_write_to_dir "$(dirname "$SCRIPT_PATH")"; then
            cp "$self" "$SCRIPT_PATH.new" && chmod +x "$SCRIPT_PATH.new" && mv -f "$SCRIPT_PATH.new" "$SCRIPT_PATH"
        else
            run_with_sudo cp "$self" "$SCRIPT_PATH.new" && run_with_sudo chmod +x "$SCRIPT_PATH.new" && run_with_sudo mv -f "$SCRIPT_PATH.new" "$SCRIPT_PATH"
        fi
        echo -e "${GREEN}Скрипт установлен: $SCRIPT_PATH${NC}"
    fi
}

install_zapret() {
    echo -e "${BLUE}Установка zapret в $ZAPRET_DIR${NC}"

    if ! can_write_to_dir "/opt"; then
        echo -e "${RED}Нет прав на запись в /opt. Выполните скрипт с sudo или от root.${NC}"
        return 1
    fi

    echo -e "${YELLOW}Проверка зависимостей...${NC}"
    check_deps || return 1

    # клонируем во временную папку, чтобы при ошибке сети не потерять рабочую установку
    local tmpdir="$ZAPRET_DIR.new"
    rm -rf "$tmpdir"
    echo -e "${GREEN}Клонирование репозитория zapret...${NC}"
    git clone --depth 1 "$ZAPRET_REPO" "$tmpdir" || {
        rm -rf "$tmpdir"
        echo -e "${RED}Ошибка клонирования. Текущая установка не тронута.${NC}"
        return 1
    }
    if [[ -d "$ZAPRET_DIR" ]]; then
        remove_zapret
    fi
    mv "$tmpdir" "$ZAPRET_DIR" || return 1

    apply_udp_patch
    build_tpws || return 1
    install_self

    load_strategies
    if tpws_supports_udp && [[ ! -f "$UDP_FILE" ]]; then
        set_use_udp "1"
        echo -e "${GREEN}UDP включён по умолчанию (профиль: $(get_udp_profile)).${NC}"
    fi
    echo -e "${GREEN}Установка завершена. Запуск: zapret start${NC}"
}

update_zapret() {
    if ! is_zapret_installed || [[ ! -d "$ZAPRET_DIR/.git" ]]; then
        echo -e "${YELLOW}zapret не установлен, выполняю установку.${NC}"
        install_zapret
        return
    fi
    local was_running=0
    pgrep -f "tpws.*--socks" > /dev/null && was_running=1

    check_deps || return 1
    echo -e "${GREEN}Обновление репозитория...${NC}"
    # откатываем прошлый патч, иначе pull упрётся в локальные изменения
    git -C "$ZAPRET_DIR" checkout -- . &>/dev/null
    git -C "$ZAPRET_DIR" clean -fdq tpws &>/dev/null
    git -C "$ZAPRET_DIR" pull --ff-only || {
        echo -e "${RED}Ошибка git pull.${NC}"
        return 1
    }
    apply_udp_patch
    [[ $was_running -eq 1 ]] && stop_zapret
    build_tpws || return 1
    install_self
    [[ $was_running -eq 1 ]] && start_zapret
    return 0
}

# -------------------------------------------------------------------
# Отладка: tpws на переднем плане с логом
# -------------------------------------------------------------------
debug_zapret() {
    local log="$HOME/zapret-debug.log"
    if ! is_zapret_installed; then
        echo -e "${RED}zapret не установлен.${NC}"; return 1
    fi
    local was_running=0
    if pgrep -f "tpws.*--socks" > /dev/null; then
        was_running=1
        pkill -f "tpws.*--socks"; sleep 1
    fi
    local cmd
    cmd=$(get_command)
    cmd="${cmd/ --daemon/} --debug=1"
    echo -e "${BLUE}Отладочный запуск. Повторите проблему (звонок, загрузку), затем нажмите Ctrl+C.${NC}"
    echo -e "${BLUE}Лог: $log${NC}"
    echo ""
    : > "$log"
    eval "$cmd" >> "$log" 2>&1 &
    local tp=$!
    trap 'kill $tp 2>/dev/null' INT TERM
    tail -n +1 -f --pid=$tp "$log" 2>/dev/null | grep --line-buffered -E "udp flow|udp resolv|could not|error|ERROR" &
    local tl=$!
    wait $tp 2>/dev/null
    while kill -0 $tp 2>/dev/null; do wait $tp 2>/dev/null; done
    kill $tl 2>/dev/null; wait $tl 2>/dev/null
    trap - INT TERM
    echo ""
    echo -e "${GREEN}Сводка по UDP-потокам:${NC}"
    grep -E "udp flow end" "$log" | sed -E 's/^udp flow end \([a-z]+\) : //' | sort | uniq -c | sort -rn | head -40
    echo ""
    echo -e "${YELLOW}Потоки с пометкой NO REPLY: пакеты ушли, но ответа не было.${NC}"
    [[ $was_running -eq 1 ]] && start_zapret
    return 0
}

